<Project>

  <PropertyGroup>
    <!-- 락스텝 버전 — 전 패키지가 이 한 값을 공유한다. 릴리즈마다 여기 한 곳만 올린다.
         규칙: 내용이 한 바이트라도 바뀌면(메타데이터 포함) 반드시 상향 — NuGet 캐시는 id+version 으로만 식별한다. -->
    <Version>0.1.2</Version>

    <Authors>cmir79ss</Authors>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/cmir79/GevSharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/cmir79/GevSharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <!-- 경고는 빌드에서 보이게 두되 실패로 올리지 않는다. 릴리즈 전에 0 으로 정리한다. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
