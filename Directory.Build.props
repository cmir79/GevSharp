<Project>

  <PropertyGroup>
    <!-- 판 번호는 여기 한 곳. main 은 언제나 마지막 릴리스이고 릴리스마다 v* 태그가 그 병합 커밋에 붙는다.
         작업은 dev 에서 하며 dev 의 번호는 "다음 판-dev" 다 — 로컬 빌드가 정식판으로 오인되지 않게. 릴리스 PR 의
         마지막 커밋에서 -dev 를 떼고, API 추가가 있으면 minor, 수정뿐이면 patch 로 확정한다(문서만 바뀐 것으로는
         내지 않는다 — 다음 판에 같이 나간다). 올린 번호는
         다시 쓰지 않는다 — NuGet 은 지울 수도 덮어쓸 수도 없다. publish.yml 이 태그와 이 값이 같은지, 태그 커밋이
         main 에 있는지 검사하고, 태그가 아닌 ref 에서는 올리지 않는다. -->
    <Version>0.4.0-dev</Version>

    <Authors>kintaein</Authors>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/cmir79/GevSharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/cmir79/GevSharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <!-- 디버그 정보를 어셈블리 안에 넣는다. 따로 두면 배포에서 떨어져 나가 스택 추적에 줄 번호가 사라지고,
         파일 하나로 배포하는 도구에서는 아예 딸려 갈 자리가 없다. 값은 0.17% 크기 — 재현 못 하는 현장 예외
         하나를 읽을 수 있게 하는 대가로는 싸다. -->
    <DebugType>embedded</DebugType>
    <!-- 소스는 넣지 않는다. 저장소가 공개라 디버거가 커밋으로 찾아갈 수 있고,
         통째로 넣으면 어셈블리가 절반 넘게 커진다(실측 503 KB → 781 KB). -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <!-- 경고는 빌드에서 보이게 두되 실패로 올리지 않는다. 릴리즈 전에 0 으로 정리한다. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
